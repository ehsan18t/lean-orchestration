{
  "description": "Loads the lean-orchestration skill once at session start so routing is in force from the first message.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/lean-autostart.mjs"],
            "timeout": 5,
            "statusMessage": "Arming lean-orchestration..."
          }
        ]
      }
    ]
  }
}
